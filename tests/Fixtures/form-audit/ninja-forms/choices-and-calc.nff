      "email_format": "html",
      "cc": "",
      "bcc": "",
      "success_msg": "Thank you for supporting the UAMS&nbsp;Winthrop P. Rockefeller Cancer Institute Miracle Stars. The tree has brightened our building and the spirits of the many patients who come through our doors each holiday season. We would like to invite you to be a part of this wonderful tradition by sponsoring a star as a special holiday greeting or to pay tribute to a special person.&nbsp; If you have any questions please call the&nbsp;<span style=\"color: rgb(33, 33, 33); font-family: &quot;Fira Sans&quot;, sans-serif; font-size: 18px;\">Cancer Institute Volunteer Office at <a href=\"tel:501-686-8286\">501-686-8286</a>.</span>",
      "parent_id": "2",
      "drawerDisabled": ""
    },
