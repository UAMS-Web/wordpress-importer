<?xml version="1.0" encoding="UTF-8"?>
<!--
    Synthetic Formidable Forms export for FormidableNotificationAuditTest.

    One form (id 1) carrying one `email` action view and one `on_submit`
    (confirmation) action view, each linked to the form via <menu_order> = form
    id. Minimal but structurally faithful to a real WXR export so the mapper's
    <view> -> email/confirmation path is exercised; no real recipient data.
-->
<formidable>
    <form>
        <id>1</id>
        <form_key>contact</form_key>
        <name>Contact</name>
        <description></description>
        <created_at>2025-08-15 09:00:00</created_at>
        <logged_in>0</logged_in>
        <is_template>0</is_template>
        <editable>0</editable>
        <options></options>
        <status>published</status>
        <parent_form_id>0</parent_form_id>
        <field>
            <id>10</id>
            <field_key>name</field_key>
            <name>Name</name>
            <description></description>
            <type>text</type>
            <default_value></default_value>
            <field_order>0</field_order>
            <form_id>1</form_id>
            <required>1</required>
            <options></options>
            <field_options></field_options>
        </field>
        <field>
            <id>11</id>
            <field_key>email</field_key>
            <name>Email</name>
            <description></description>
            <type>email</type>
            <default_value></default_value>
            <field_order>1</field_order>
            <form_id>1</form_id>
            <required>1</required>
            <options></options>
            <field_options></field_options>
        </field>
    </form>
    <view>
        <title>Email Notification</title>
        <link></link>
        <post_author><![CDATA[audit]]></post_author>
        <description></description>
        <content><![CDATA[{"email_to":"[admin_email]","cc":"","bcc":"","from":"[admin_email]","reply_to":"","email_subject":"New Contact submission","email_message":"[default-message]","inc_user_info":"","plain_text":"","email_attachment_id":"","event":["create"],"conditions":{"send_stop":"","any_all":""}}]]></content>
        <excerpt><![CDATA[email]]></excerpt>
        <post_id>100</post_id>
        <post_date>2025-08-15 09:00:00</post_date>
        <post_name>1_email_100</post_name>
        <status>publish</status>
        <post_parent>0</post_parent>
        <menu_order>1</menu_order>
        <post_type>frm_form_actions</post_type>
    </view>
    <view>
        <title>Confirmation</title>
        <link></link>
        <post_author><![CDATA[audit]]></post_author>
        <description></description>
        <content><![CDATA[{"success_action":"message","success_msg":"Your response was submitted. Thank you!","show_form":"","event":["create"],"conditions":{"send_stop":"","any_all":""}}]]></content>
        <excerpt><![CDATA[on_submit]]></excerpt>
        <post_id>101</post_id>
        <post_date>2025-08-15 09:00:00</post_date>
        <post_name>1_on_submit_101</post_name>
        <status>publish</status>
        <post_parent>0</post_parent>
        <menu_order>1</menu_order>
        <post_type>frm_form_actions</post_type>
    </view>
</formidable>
